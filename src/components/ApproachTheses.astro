---
import { getUi, resolveLocale } from "../i18n";

const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale);
const { theses, closing, chartHint } = ui.approach;

/** Gantt-like spans: overlapping positions, not a strict sequence */
const spans = [
  { start: 0, end: 68 },
  { start: 18, end: 82 },
  { start: 36, end: 100 },
] as const;
---

<section class="approach-chart" aria-label={ui.approach.label} data-approach-chart>
  <div class="page-shell">
    <p class="approach-chart__hint">{chartHint}</p>

    <div class="gantt" role="tablist" aria-label={ui.approach.title}>
      {
        theses.map((thesis, index) => {
          const span = spans[index] ?? spans[0];
          const id = `phase-${index}`;
          return (
            <button
              type="button"
              class="gantt__row"
              role="tab"
              id={`${id}-tab`}
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`${id}-panel`}
              data-phase-tab={index}
            >
              <span class="gantt__label">
                <span class="gantt__index">{String(index + 1).padStart(2, "0")}</span>
                <span class="gantt__tag">{thesis.tag}</span>
              </span>
              <span class="gantt__track" aria-hidden="true">
                <span
                  class="gantt__bar"
                  style={`--bar-start: ${span.start}%; --bar-end: ${span.end}%;`}
                >
                  <span class="gantt__bar-title">{thesis.title}</span>
                </span>
              </span>
            </button>
          );
        })
      }
    </div>

    <div class="approach-chart__panels">
      {
        theses.map((thesis, index) => {
          const id = `phase-${index}`;
          const open = index === 0;
          return (
            <article
              class="phase-panel"
              id={`${id}-panel`}
              role="tabpanel"
              aria-labelledby={`${id}-tab`}
              data-phase-panel={index}
              hidden={!open}
            >
              <p class="phase-panel__tag">{thesis.tag}</p>
              <h2 class="phase-panel__statement">{thesis.statement}</h2>
              <p class="phase-panel__body">{thesis.body}</p>
              {thesis.quote ? (
                <blockquote class="phase-panel__quote">
                  <p>{thesis.quote}</p>
                  {thesis.quoteAttr ? <cite>{thesis.quoteAttr}</cite> : null}
                </blockquote>
              ) : null}
            </article>
          );
        })
      }
    </div>

    <p class="approach-chart__closing">{closing}</p>
  </div>
</section>

<script>
  import { initApproachChart } from "../scripts/approach-motion";

  initApproachChart();
</script>

<style>
  .approach-chart {
    padding-block: var(--space-md) var(--space-xl);
  }

  .approach-chart__hint {
    margin: 0 0 var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .gantt {
    display: grid;
    gap: 0.55rem;
    padding: 1rem 1.05rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--line) 90%, transparent);
    border-radius: var(--radius);
    background:
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--line) 35%, transparent) 0,
        color-mix(in srgb, var(--line) 35%, transparent) 1px,
        transparent 1px
      )
      0 0 / calc(100% / 5) 100%,
      color-mix(in srgb, var(--paper) 70%, white);
  }

  .gantt__row {
    display: grid;
    grid-template-columns: minmax(7.5rem, 9.5rem) minmax(0, 1fr);
    gap: 0.85rem;
    align-items: center;
    width: 100%;
    margin: 0;
    padding: 0.2rem 0;
    border: 0;
    background: transparent;
    text-align: left;
    cursor: pointer;
    color: inherit;
  }

  .gantt__row:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 0.25rem;
  }

  .gantt__label {
    display: grid;
    gap: 0.15rem;
  }

  .gantt__index {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--accent);
  }

  .gantt__tag {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--ink-muted);
    transition: color 180ms var(--ease);
  }

  .gantt__row[aria-selected="true"] .gantt__tag {
    color: var(--ink);
  }

  .gantt__track {
    position: relative;
    height: 2rem;
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--ink) 4%, transparent);
  }

  .gantt__bar {
    position: absolute;
    top: 0.28rem;
    bottom: 0.28rem;
    left: var(--bar-start);
    width: calc(var(--bar-end) - var(--bar-start));
    display: flex;
    align-items: center;
    padding: 0 0.65rem;
    border-radius: 0.2rem;
    background: color-mix(in srgb, var(--ink-muted) 18%, var(--paper));
    border: 1px solid color-mix(in srgb, var(--ink-muted) 22%, transparent);
    transition:
      background 200ms var(--ease),
      border-color 200ms var(--ease),
      box-shadow 200ms var(--ease);
  }

  .gantt__row:hover .gantt__bar,
  .gantt__row[aria-selected="true"] .gantt__bar {
    background: color-mix(in srgb, var(--accent) 16%, white);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    box-shadow: 0 8px 18px -14px rgba(10, 92, 92, 0.55);
  }

  .gantt__bar-title {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .approach-chart__panels {
    margin-top: var(--space-md);
    min-height: 11rem;
  }

  .phase-panel {
    max-width: 38rem;
    display: grid;
    gap: 0.65rem;
  }

  /* class display beats the UA [hidden] rule — restore hide */
  .phase-panel[hidden] {
    display: none;
  }

  .phase-panel__tag {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .phase-panel__statement {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.2vw, 1.55rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .phase-panel__body {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .phase-panel__quote {
    margin: 0.2rem 0 0;
    padding: 0.7rem 0 0.1rem 0.9rem;
    border-left: 2px solid color-mix(in srgb, var(--accent) 55%, var(--line));
  }

  .phase-panel__quote p {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.98rem;
    line-height: 1.45;
    color: var(--ink);
  }

  .phase-panel__quote cite {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-style: normal;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .approach-chart__closing {
    margin: var(--space-lg) 0 0;
    max-width: 34rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.4;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .gantt__row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .gantt__track {
      height: 2.15rem;
    }

    .gantt__label {
      grid-template-columns: auto 1fr;
      align-items: baseline;
      gap: 0.55rem;
    }
  }
</style>
