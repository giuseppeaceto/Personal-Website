---
import { getSite, getUi, resolveLocale } from "../i18n";

const locale = resolveLocale(Astro.currentLocale);
const site = getSite(locale);
const ui = getUi(locale);
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="hero__plate" aria-hidden="true">
    <div class="hero__fallback"></div>
    <canvas class="hero__canvas" data-hero-canvas></canvas>
  </div>

  <div class="page-shell hero__opening">
    <h1 id="hero-name" class="hero__name">{site.name}</h1>
    <p class="hero__tagline">{site.tagline}</p>
    <div class="hero__meta">
      <p class="hero__roles">{ui.hero.meta}</p>
      <p class="hero__index">
        <a href="#work">{ui.hero.indexWork}</a>
        <span aria-hidden="true">·</span>
        <a href="#sound">{ui.hero.indexSound}</a>
      </p>
    </div>
  </div>
</section>

<script>
  import { initHeroField } from "../scripts/hero-field";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-canvas]");
  const plate = canvas?.closest(".hero__plate");

  if (canvas && plate) {
    const handle = initHeroField(canvas);
    if (handle) {
      plate.classList.add("is-webgl");
    }
  }
</script>

<style>
  .hero {
    position: relative;
  }

  /* Field as a plate — not a marketing backdrop behind copy */
  .hero__plate {
    position: relative;
    height: clamp(14rem, 38vh, 22rem);
    overflow: hidden;
    isolation: isolate;
    animation: fade-in 1.1s var(--ease) both;
  }

  .hero__fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 65% 55% at 84% 10%,
        color-mix(in srgb, var(--accent) 22%, #9aabb4) 0%,
        color-mix(in srgb, var(--accent) 8%, transparent) 48%,
        transparent 72%
      ),
      radial-gradient(
        ellipse 58% 72% at 16% 18%,
        rgba(255, 253, 249, 0.95) 0%,
        rgba(255, 248, 240, 0.45) 38%,
        transparent 70%
      ),
      linear-gradient(
        152deg,
        #c5ccd2 0%,
        #dce0e4 30%,
        var(--paper) 58%,
        #d6d2cc 100%
      );
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.9s var(--ease);
  }

  .hero__plate.is-webgl .hero__canvas {
    opacity: 1;
  }

  .hero__plate.is-webgl .hero__fallback {
    opacity: 0;
  }

  .hero__opening {
    padding-block: var(--space-lg) var(--space-xl);
    border-bottom: 1px solid var(--line);
  }

  .hero__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5.5vw, 3.75rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    animation: rise-in 0.9s var(--ease) 0.08s both;
  }

  .hero__tagline {
    margin: var(--space-md) 0 0;
    max-width: 28rem;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 1.75rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    animation: rise-in 0.9s var(--ease) 0.2s both;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--line);
    animation: rise-in 0.9s var(--ease) 0.32s both;
  }

  .hero__roles {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.98rem;
    line-height: 1.45;
    color: var(--ink-muted);
  }

  .hero__index {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.65rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .hero__index a {
    text-decoration: none;
    color: var(--ink);
  }

  .hero__index a:hover {
    color: var(--accent);
  }

  .hero__index span {
    color: var(--ink-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__plate {
      animation: none;
    }

    .hero__name,
    .hero__tagline,
    .hero__meta {
      animation: none;
    }
  }
</style>
