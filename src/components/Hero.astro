---
import { getUi, resolveLocale } from "../i18n";

const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale);
---

<section class="hero" id="top">
  <div class="page-shell hero__shell">
    <div class="hero__card">
      <div class="hero__field">
        <div class="hero__plate" aria-hidden="true">
          <div class="hero__fallback"></div>
          <canvas class="hero__canvas" data-hero-canvas></canvas>
        </div>
        <figure class="hero__note">
          <blockquote class="hero__quote" cite={ui.hero.quoteCite}>
            <p>{ui.hero.quote}</p>
          </blockquote>
          <figcaption class="hero__attribution">
            <cite>{ui.hero.quoteAuthor}</cite>
            <span class="hero__context">{ui.hero.quoteContext}</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<script>
  import { initHeroField } from "../scripts/hero-field";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-canvas]");
  const plate = canvas?.closest(".hero__plate");
  const field = canvas && plate ? initHeroField(canvas) : null;

  if (field && plate) {
    plate.classList.add("is-webgl");
  }
</script>

<style>
  .hero {
    --hero-radius: 1.35rem;
    padding: 4.35rem 0 0;
  }

  .hero__card {
    border-radius: var(--hero-radius);
    border: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
    background: var(--paper);
    box-shadow:
      0 1px 0 color-mix(in srgb, white 55%, transparent) inset,
      0 18px 40px -28px rgba(26, 28, 31, 0.28),
      0 6px 14px -8px rgba(26, 28, 31, 0.1);
    animation: fade-in 1.1s var(--ease) both;
  }

  .hero__field {
    position: relative;
    overflow: hidden;
    width: 100%;
    min-height: clamp(22rem, 56svh, 34rem);
    border-radius: var(--hero-radius);
    isolation: isolate;
    clip-path: inset(0 round var(--hero-radius));
  }

  .hero__plate,
  .hero__fallback,
  .hero__canvas {
    border-radius: inherit;
  }

  .hero__plate {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: var(--hero-radius);
  }

  .hero__fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 65% 55% at 84% 10%,
        color-mix(in srgb, var(--accent) 22%, #9aabb4) 0%,
        color-mix(in srgb, var(--accent) 8%, transparent) 48%,
        transparent 72%
      ),
      radial-gradient(
        ellipse 58% 72% at 16% 18%,
        rgba(255, 253, 249, 0.95) 0%,
        rgba(255, 248, 240, 0.45) 38%,
        transparent 70%
      ),
      linear-gradient(
        152deg,
        #c5ccd2 0%,
        #dce0e4 30%,
        var(--paper) 58%,
        #d6d2cc 100%
      );
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.9s var(--ease);
  }

  .hero__plate.is-webgl .hero__canvas {
    opacity: 1;
  }

  .hero__plate.is-webgl .hero__fallback {
    opacity: 0;
  }

  .hero__note {
    position: absolute;
    z-index: 2;
    right: 1.05rem;
    bottom: 1.05rem;
    max-width: min(26rem, calc(100% - 2.1rem));
    margin: 0;
    padding: 0.85rem 0.95rem 0.75rem;
    border: 1px solid color-mix(in srgb, white 62%, var(--line));
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--paper) 46%, transparent);
    box-shadow:
      0 1px 0 color-mix(in srgb, white 70%, transparent) inset,
      0 14px 32px -22px rgba(26, 28, 31, 0.55);
    backdrop-filter: blur(18px) saturate(1.2);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    animation: rise-in 0.9s var(--ease) 0.28s both;
  }

  .hero__quote {
    margin: 0;
  }

  .hero__quote p {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.1vw, 1.28rem);
    font-weight: 500;
    line-height: 1.38;
    letter-spacing: -0.025em;
  }

  .hero__quote p::before {
    content: "“";
    margin-right: 0.02em;
    color: var(--accent);
  }

  .hero__quote p::after {
    content: "”";
    margin-left: 0.02em;
    color: var(--accent);
  }

  .hero__attribution {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-top: 0.65rem;
    padding-top: 0.55rem;
    border-top: 1px solid color-mix(in srgb, var(--line) 55%, transparent);
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--ink-muted);
    font-style: normal;
  }

  .hero__attribution cite {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-style: normal;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .hero__context {
    font-size: 0.76rem;
    line-height: 1.35;
  }

  @media (max-width: 860px) {
    .hero {
      --hero-radius: 1.1rem;
      padding-top: 4rem;
    }
  }

  @media (max-width: 520px) {
    .hero {
      --hero-radius: 0.95rem;
    }

    .hero__note {
      right: 0.75rem;
      bottom: 0.75rem;
      max-width: min(26rem, calc(100% - 1.5rem));
      padding: 0.75rem 0.85rem 0.65rem;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .hero__note {
      background: var(--surface-solid);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__card,
    .hero__note {
      animation: none;
    }
  }
</style>
