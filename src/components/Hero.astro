---
import { site } from "../data/site";
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="hero__field" aria-hidden="true">
    <div class="hero__grid"></div>
    <div class="hero__glow"></div>
  </div>

  <div class="page-shell hero__content">
    <p class="hero__meta">Designer · Philosopher · AI Ethicist</p>
    <h1 id="hero-name" class="hero__name">{site.name}</h1>
    <p class="hero__tagline">{site.tagline}</p>
    <div class="hero__actions">
      <a class="hero__cta" href="#work">Selected work</a>
      <a class="hero__link" href="#contact">Get in touch</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100vh, 56rem);
    display: grid;
    align-items: end;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__field {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, transparent 35%, rgba(233, 236, 239, 0.92) 100%),
      radial-gradient(ellipse 90% 60% at 70% 35%, rgba(12, 107, 107, 0.18), transparent 60%),
      linear-gradient(135deg, #c5ced6 0%, #e8ecef 45%, #b7c4c8 100%);
    animation: fade-in 1.1s var(--ease) both;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(22, 25, 29, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(22, 25, 29, 0.06) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 55% at 65% 40%, black, transparent 75%);
    animation: fade-in 1.4s var(--ease) 0.15s both;
  }

  .hero__glow {
    position: absolute;
    width: min(55vw, 28rem);
    height: min(55vw, 28rem);
    right: 8%;
    top: 18%;
    border-radius: 50%;
    border: 1px solid rgba(12, 107, 107, 0.28);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25);
    animation: fade-in 1.6s var(--ease) 0.25s both;
  }

  .hero__content {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .hero__meta {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    animation: rise-in 0.9s var(--ease) 0.1s both;
  }

  .hero__name {
    margin: 0;
    max-width: 12ch;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 10vw, 6.5rem);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.035em;
    animation: rise-in 1s var(--ease) 0.2s both;
  }

  .hero__tagline {
    margin: var(--space-md) 0 0;
    max-width: 22rem;
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    line-height: 1.4;
    color: var(--ink-muted);
    animation: rise-in 1s var(--ease) 0.35s both;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: var(--space-lg);
    animation: rise-in 1s var(--ease) 0.45s both;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.15rem;
    background: var(--ink);
    color: #f3f5f7;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hero__cta:hover {
    background: var(--accent);
    color: #f3f5f7;
  }

  .hero__link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 100svh;
      align-items: end;
    }

    .hero__glow {
      right: -10%;
      top: 12%;
      opacity: 0.7;
    }
  }
</style>
