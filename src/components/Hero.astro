---
import { getSite, getUi, resolveLocale } from "../i18n";

const locale = resolveLocale(Astro.currentLocale);
const site = getSite(locale);
const ui = getUi(locale);
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="hero__field">
    <div class="hero__plate" aria-hidden="true">
      <div class="hero__fallback"></div>
      <canvas class="hero__canvas" data-hero-canvas></canvas>
    </div>

    <div class="page-shell hero__copy">
      <div class="hero__glass">
        <h1 id="hero-name" class="hero__name">{site.name}</h1>
        <p class="hero__tagline">{site.tagline}</p>
        <p class="hero__roles">{ui.hero.meta}</p>
      </div>
    </div>
    <a class="hero__scroll" href="#work">{ui.hero.scroll}</a>
  </div>
</section>

<script>
  import { initHeroField } from "../scripts/hero-field";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-canvas]");
  const plate = canvas?.closest(".hero__plate");

  if (canvas && plate) {
    const handle = initHeroField(canvas);
    if (handle) {
      plate.classList.add("is-webgl");
    }
  }
</script>

<style>
  .hero {
    padding: 0 0 var(--space-lg);
  }

  .hero__field {
    position: relative;
    overflow: hidden;
    width: 100%;
    min-height: 100svh;
    background: transparent;
    isolation: isolate;
    animation: fade-in 1.1s var(--ease) both;
  }

  .hero__copy {
    position: absolute;
    z-index: 1;
    inset: auto 0 6.4rem;
    pointer-events: none;
  }

  .hero__scroll {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: 1.15rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
  }

  .hero__scroll::after {
    content: "";
    width: 1px;
    height: 1.65rem;
    background: currentColor;
    transform-origin: top;
    animation: hero-scroll 1.8s var(--ease) infinite;
  }

  @keyframes hero-scroll {
    0%,
    100% {
      transform: scaleY(0.35);
      opacity: 0.35;
    }

    50% {
      transform: scaleY(1);
      opacity: 0.9;
    }
  }

  .hero__plate {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 65% 55% at 84% 10%,
        color-mix(in srgb, var(--accent) 22%, #9aabb4) 0%,
        color-mix(in srgb, var(--accent) 8%, transparent) 48%,
        transparent 72%
      ),
      radial-gradient(
        ellipse 58% 72% at 16% 18%,
        rgba(255, 253, 249, 0.95) 0%,
        rgba(255, 248, 240, 0.45) 38%,
        transparent 70%
      ),
      linear-gradient(
        152deg,
        #c5ccd2 0%,
        #dce0e4 30%,
        var(--paper) 58%,
        #d6d2cc 100%
      );
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.9s var(--ease);
  }

  .hero__plate.is-webgl .hero__canvas {
    opacity: 1;
  }

  .hero__plate.is-webgl .hero__fallback {
    opacity: 0;
  }

  .hero__glass {
    position: relative;
    z-index: 1;
    max-width: 28rem;
    pointer-events: auto;
    padding: 1.1rem 1.2rem 1.15rem;
    border: 1px solid color-mix(in srgb, white 55%, var(--line));
    border-radius: calc(var(--radius) - 0.15rem);
    background: color-mix(in srgb, var(--paper) 72%, transparent);
    box-shadow: 0 1px 0 color-mix(in srgb, white 40%, transparent) inset;
    animation: rise-in 0.9s var(--ease) 0.1s both;
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .hero__glass {
      background: color-mix(in srgb, var(--paper) 58%, transparent);
      backdrop-filter: blur(14px) saturate(1.15);
      -webkit-backdrop-filter: blur(14px) saturate(1.15);
    }
  }

  .hero__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.2vw, 2.55rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .hero__tagline {
    margin: 0.75rem 0 0;
    max-width: 24rem;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.7vw, 1.3rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .hero__roles {
    margin: 0.95rem 0 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--ink-muted);
  }

  @media (max-width: 860px) {
    .hero__copy {
      inset: auto 0 6.2rem;
    }

    .hero__glass {
      max-width: none;
      padding: 0.95rem 1rem 1rem;
    }
  }

  @media (max-width: 520px) {
    .hero__name {
      font-size: clamp(1.65rem, 8vw, 2rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__field,
    .hero__glass,
    .hero__scroll::after {
      animation: none;
    }
  }
</style>
