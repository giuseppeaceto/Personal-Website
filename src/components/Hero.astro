---
import { formatSchoolYears, getSchoolYearsClock } from "../data/school-years";
import { getUi, resolveLocale } from "../i18n";

const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale);
const clock = getSchoolYearsClock();
const initialCount = formatSchoolYears(clock.perSecond, locale);
---

<section class="hero" id="top">
  <div class="page-shell hero__shell">
    <div class="hero__card">
      <div class="hero__field">
        <div class="hero__plate" aria-hidden="true">
          <div class="hero__fallback"></div>
          <canvas class="hero__canvas" data-hero-canvas></canvas>
        </div>
        <figure
          class="hero__note"
          data-school-clock
          data-per-second={clock.perSecond}
          data-locale={locale}
        >
          <p class="hero__value">
            <span class="hero__live" aria-hidden="true"></span>
            <span data-school-value>{initialCount}</span>
          </p>
          <figcaption>
            <p class="hero__caption">{ui.hero.note}</p>
            <p class="hero__sources">
              <a
                class="hero__source"
                href={clock.schoolSourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                title={ui.hero.schoolSourceTitle}
              >
                {ui.hero.schoolSource}<span aria-hidden="true"> · </span>{clock.schoolYear}
              </a>
              <span aria-hidden="true"> · </span>
              <a
                class="hero__source"
                href={clock.militarySourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                title={ui.hero.militarySourceTitle}
              >
                {ui.hero.militarySource}<span aria-hidden="true"> · </span>{clock.militaryYear}
              </a>
            </p>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<script>
  import { formatSchoolYears } from "../data/school-years";
  import { initHeroField } from "../scripts/hero-field";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-canvas]");
  const plate = canvas?.closest(".hero__plate");
  const field = canvas && plate ? initHeroField(canvas) : null;

  if (field && plate) {
    plate.classList.add("is-webgl");
  }

  const schoolClock = document.querySelector<HTMLElement>("[data-school-clock]");
  const value = schoolClock?.querySelector<HTMLElement>("[data-school-value]");
  const perSecond = Number(schoolClock?.dataset.perSecond);

  if (schoolClock && value && Number.isFinite(perSecond) && perSecond > 0) {
    const clockLocale = schoolClock.dataset.locale === "en" ? "en" : "it";
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const started = performance.now();
    let shown = "";
    let pulses = 0;

    const paint = (amount: number) => {
      const next = formatSchoolYears(amount, clockLocale);
      if (next === shown) return;
      shown = next;
      value.textContent = next;
    };

    if (reduceMotion) {
      const render = () => {
        const seconds = Math.floor((performance.now() - started) / 1000) + 1;
        paint(perSecond * seconds);
        field?.pulse();
      };
      render();
      window.setInterval(render, 1000);
    } else {
      const frame = (now: number) => {
        const seconds = (now - started) / 1000 + 1;
        paint(perSecond * seconds);
        const due = Math.floor(seconds);
        if (due > pulses) {
          pulses = due;
          field?.pulse();
        }
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }
  }
</script>

<style>
  .hero {
    --hero-radius: 1.35rem;
    padding: 4.35rem 0 0;
  }

  .hero__card {
    border-radius: var(--hero-radius);
    border: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
    background: var(--paper);
    box-shadow:
      0 1px 0 color-mix(in srgb, white 55%, transparent) inset,
      0 18px 40px -28px rgba(26, 28, 31, 0.28),
      0 6px 14px -8px rgba(26, 28, 31, 0.1);
    animation: fade-in 1.1s var(--ease) both;
  }

  .hero__field {
    position: relative;
    overflow: hidden;
    width: 100%;
    min-height: clamp(18rem, 42svh, 26rem);
    border-radius: var(--hero-radius);
    isolation: isolate;
    clip-path: inset(0 round var(--hero-radius));
  }

  .hero__plate,
  .hero__fallback,
  .hero__canvas {
    border-radius: inherit;
  }

  .hero__plate {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: var(--hero-radius);
  }

  .hero__fallback {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 65% 55% at 84% 10%,
        color-mix(in srgb, var(--accent) 22%, #9aabb4) 0%,
        color-mix(in srgb, var(--accent) 8%, transparent) 48%,
        transparent 72%
      ),
      radial-gradient(
        ellipse 58% 72% at 16% 18%,
        rgba(255, 253, 249, 0.95) 0%,
        rgba(255, 248, 240, 0.45) 38%,
        transparent 70%
      ),
      linear-gradient(
        152deg,
        #c5ccd2 0%,
        #dce0e4 30%,
        var(--paper) 58%,
        #d6d2cc 100%
      );
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.9s var(--ease);
  }

  .hero__plate.is-webgl .hero__canvas {
    opacity: 1;
  }

  .hero__plate.is-webgl .hero__fallback {
    opacity: 0;
  }

  .hero__note {
    position: absolute;
    z-index: 2;
    right: 1.05rem;
    bottom: 1.05rem;
    max-width: min(15.5rem, calc(100% - 2.1rem));
    margin: 0;
    padding: 0.6rem 0.7rem 0.5rem;
    border: 1px solid color-mix(in srgb, white 62%, var(--line));
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--paper) 46%, transparent);
    box-shadow:
      0 1px 0 color-mix(in srgb, white 70%, transparent) inset,
      0 14px 32px -22px rgba(26, 28, 31, 0.55);
    backdrop-filter: blur(18px) saturate(1.2);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    animation: rise-in 0.9s var(--ease) 0.28s both;
  }

  .hero__value,
  .hero__caption {
    margin: 0;
  }

  .hero__value {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .hero__live {
    width: 0.32rem;
    height: 0.32rem;
    flex: none;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 45%, transparent);
    animation: hero-live 2.4s var(--ease) infinite;
  }

  @keyframes hero-live {
    0%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 0%, transparent);
    }
    45% {
      box-shadow: 0 0 0 0.38rem color-mix(in srgb, var(--accent) 0%, transparent);
    }
    20% {
      box-shadow: 0 0 0 0.12rem color-mix(in srgb, var(--accent) 28%, transparent);
    }
  }

  .hero__caption {
    margin-top: 0.32rem;
    font-size: 0.8rem;
    line-height: 1.3;
    white-space: pre-line;
  }

  .hero__sources {
    margin: 0.4rem 0 0;
  }

  .hero__source {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    color: var(--ink-muted);
  }

  .hero__source:hover {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .hero {
      --hero-radius: 1.1rem;
      padding-top: 4rem;
    }
  }

  @media (max-width: 520px) {
    .hero {
      --hero-radius: 0.95rem;
    }

    .hero__note {
      right: 0.75rem;
      bottom: 0.75rem;
      max-width: min(15.5rem, calc(100% - 1.5rem));
      padding: 0.55rem 0.65rem 0.45rem;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .hero__note {
      background: var(--surface-solid);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__card,
    .hero__note,
    .hero__live {
      animation: none;
    }
  }
</style>
