---
import { getSite, getUi, resolveLocale } from "../i18n";

const locale = resolveLocale(Astro.currentLocale);
const { about } = getSite(locale);
const ui = getUi(locale);
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="page-shell about__grid">
    <div>
      <p class="section__label">{ui.about.label}</p>
      <h2 class="section__title" id="about-title">{about.title}</h2>
    </div>
    <div class="about__copy">
      <p class="about__lead">{about.lead}</p>
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(12rem, 0.85fr) 1.15fr;
    gap: var(--space-lg);
    align-items: start;
  }

  .about__copy {
    display: grid;
    gap: 1rem;
    max-width: 40rem;
  }

  .about__copy p {
    margin: 0;
    color: var(--ink-muted);
    font-size: 1.08rem;
  }

  .about__lead {
    color: var(--ink) !important;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.4rem) !important;
    line-height: 1.45;
  }

  @media (max-width: 800px) {
    .about__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>
