---
import {
  getUi,
  homePath,
  localizedPath,
  pagePath,
  resolveLocale,
} from "../i18n";

const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale);
const itHref = localizedPath(Astro.url.pathname, "it");
const enHref = localizedPath(Astro.url.pathname, "en");
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  { href: pagePath(locale, "about"), label: ui.nav.about },
  { href: pagePath(locale, "approach"), label: ui.nav.approach },
  { href: pagePath(locale, "work"), label: ui.nav.work },
  { href: pagePath(locale, "writing"), label: ui.nav.writing },
  { href: pagePath(locale, "contact"), label: ui.nav.contact },
];

function isCurrent(href: string) {
  const target = href.replace(/\/$/, "") || "/";
  return pathname === target || pathname.startsWith(`${target}/`);
}
---

<header class="site-header" data-site-header>
  <div class="page-shell site-header__shell">
    <div class="site-header__inner">
      <a
        class="site-header__brand"
        href={homePath(locale)}
        aria-label={ui.brandAria}
      >
        G. Aceto
      </a>
      <div class="site-header__end">
        <nav class="site-header__nav" aria-label={ui.navAria}>
          {
            links.map((link) => (
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
        <nav class="site-header__lang" aria-label={ui.langSwitch.label}>
          <a
            href={itHref}
            hreflang="it"
            lang="it"
            aria-current={locale === "it" ? "true" : undefined}
            >{ui.langSwitch.it}</a
          >
          <span aria-hidden="true">/</span>
          <a
            href={enHref}
            hreflang="en"
            lang="en"
            aria-current={locale === "en" ? "true" : undefined}
            >{ui.langSwitch.en}</a
          >
        </nav>
        <button
          class="site-header__menu-btn"
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="site-menu"
        >
          <span class="site-header__menu-label" data-menu-label-open
            >{ui.nav.menuOpen}</span
          >
          <span class="site-header__menu-label" data-menu-label-close hidden
            >{ui.nav.menuClose}</span
          >
        </button>
      </div>
    </div>
  </div>

  <div
    class="site-header__drawer"
    id="site-menu"
    data-menu-drawer
    hidden
  >
    <div class="page-shell">
      <nav class="site-header__drawer-nav" aria-label={ui.navAria}>
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    padding: 0.75rem 0 0;
    pointer-events: none;
  }

  .site-header__shell,
  .site-header__drawer {
    pointer-events: none;
  }

  .site-header__inner,
  .site-header__drawer-nav,
  .site-header__menu-btn {
    pointer-events: auto;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.85rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid color-mix(in srgb, white 55%, var(--line));
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--paper) 58%, transparent);
    box-shadow:
      0 1px 0 color-mix(in srgb, white 40%, transparent) inset,
      0 8px 24px -14px rgba(26, 28, 31, 0.28),
      0 2px 8px -4px rgba(26, 28, 31, 0.1);
    backdrop-filter: blur(16px) saturate(1.15);
    -webkit-backdrop-filter: blur(16px) saturate(1.15);
    transition:
      background 280ms var(--ease),
      border-color 280ms var(--ease),
      box-shadow 280ms var(--ease);
  }

  .site-header.is-scrolled .site-header__inner,
  .site-header.is-open .site-header__inner {
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    border-color: var(--line);
    box-shadow:
      0 1px 0 color-mix(in srgb, white 55%, transparent) inset,
      0 14px 32px -16px rgba(26, 28, 31, 0.36),
      0 4px 12px -6px rgba(26, 28, 31, 0.14);
  }

  .site-header__brand {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .site-header__end {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.85rem 1.15rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-header__nav a,
  .site-header__drawer-nav a {
    text-decoration: none;
    color: var(--ink-muted);
  }

  .site-header__nav a:hover,
  .site-header__drawer-nav a:hover {
    color: var(--ink);
  }

  .site-header__nav a[aria-current="page"],
  .site-header__drawer-nav a[aria-current="page"] {
    color: var(--ink);
  }

  .site-header__lang {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
  }

  .site-header__lang a {
    text-decoration: none;
    color: var(--ink-muted);
  }

  .site-header__lang a[aria-current="true"] {
    color: var(--ink);
  }

  .site-header__lang a:hover {
    color: var(--accent);
  }

  .site-header__menu-btn {
    display: none;
    margin: 0;
    padding: 0.2rem 0;
    border: 0;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    cursor: pointer;
  }

  .site-header__menu-btn:hover {
    color: var(--accent);
  }

  .site-header__drawer {
    margin-top: 0.45rem;
  }

  .site-header__drawer[hidden] {
    display: none;
  }

  .site-header__drawer-nav {
    display: grid;
    gap: 0.15rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--paper) 92%, white);
    box-shadow: 0 14px 28px -22px rgba(26, 28, 31, 0.45);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-header__drawer-nav a {
    padding: 0.55rem 0.15rem;
  }

  @media (max-width: 860px) {
    .site-header__nav {
      display: none;
    }

    .site-header__menu-btn {
      display: inline-flex;
    }

    .site-header {
      padding-top: 0.55rem;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header__inner,
    .site-header.is-scrolled .site-header__inner,
    .site-header.is-open .site-header__inner,
    .site-header__drawer-nav {
      background: var(--surface-solid);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const drawer = header?.querySelector<HTMLElement>("[data-menu-drawer]");
  const openLabel = header?.querySelector<HTMLElement>("[data-menu-label-open]");
  const closeLabel = header?.querySelector<HTMLElement>(
    "[data-menu-label-close]",
  );

  if (header && toggle && drawer && openLabel && closeLabel) {
    const setOpen = (open: boolean) => {
      header.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      drawer.hidden = !open;
      openLabel.hidden = open;
      closeLabel.hidden = !open;
      document.body.style.overflow = open ? "hidden" : "";
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    drawer.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });

    window.addEventListener(
      "resize",
      () => {
        if (window.matchMedia("(min-width: 861px)").matches) setOpen(false);
      },
      { passive: true },
    );

    const onScroll = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 20);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
