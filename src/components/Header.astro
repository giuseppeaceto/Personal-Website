---
import {
  getUi,
  homePath,
  localizedPath,
  resolveLocale,
  sectionHref,
} from "../i18n";

const locale = resolveLocale(Astro.currentLocale);
const ui = getUi(locale);
const itHref = localizedPath(Astro.url.pathname, "it");
const enHref = localizedPath(Astro.url.pathname, "en");

const links = [
  { href: sectionHref(locale, "work"), label: ui.nav.work },
  { href: sectionHref(locale, "sound"), label: ui.nav.sound },
  { href: sectionHref(locale, "writing"), label: ui.nav.writing },
  { href: sectionHref(locale, "about"), label: ui.nav.about },
  { href: sectionHref(locale, "contact"), label: ui.nav.contact },
];
---

<header class="site-header">
  <div class="page-shell site-header__shell">
    <div class="site-header__inner">
      <a class="site-header__brand" href={homePath(locale)} aria-label={ui.brandAria}>
        G. Aceto
      </a>
      <div class="site-header__end">
        <nav class="site-header__nav" aria-label={ui.navAria}>
          {
            links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))
          }
        </nav>
        <nav class="site-header__lang" aria-label={ui.langSwitch.label}>
          <a
            href={itHref}
            hreflang="it"
            lang="it"
            aria-current={locale === "it" ? "true" : undefined}>{ui.langSwitch.it}</a
          >
          <span aria-hidden="true">/</span>
          <a
            href={enHref}
            hreflang="en"
            lang="en"
            aria-current={locale === "en" ? "true" : undefined}>{ui.langSwitch.en}</a
          >
        </nav>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    padding: 0.75rem 0 0;
    pointer-events: none;
  }

  .site-header__shell {
    pointer-events: none;
  }

  .site-header__inner {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.85rem;
    padding: 0.45rem 0.85rem;
    background: transparent;
    border: 1px solid transparent;
    transition:
      background 280ms var(--ease),
      border-color 280ms var(--ease);
  }

  .site-header.is-scrolled .site-header__inner {
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    border-color: var(--line);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .site-header__brand {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .site-header__end {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.85rem 1.15rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-header__nav a {
    text-decoration: none;
    color: var(--ink-muted);
  }

  .site-header__nav a:hover {
    color: var(--ink);
  }

  .site-header__lang {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
  }

  .site-header__lang a {
    text-decoration: none;
    color: var(--ink-muted);
  }

  .site-header__lang a[aria-current="true"] {
    color: var(--ink);
  }

  .site-header__lang a:hover {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .site-header__nav {
      display: none;
    }

    .site-header {
      padding-top: 0.55rem;
    }
  }
</style>

<script>
  const header = document.querySelector(".site-header");
  if (header) {
    const onScroll = () => {
      header.classList.toggle("is-scrolled", window.scrollY > 20);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
