---
import { getSite, getUi, resolveLocale } from "../i18n";

const locale = resolveLocale(Astro.currentLocale);
const site = getSite(locale);
const ui = getUi(locale);
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="page-shell">
    <p class="section__label">{ui.contact.label}</p>
    <h2 class="section__title" id="contact-title">{ui.contact.title}</h2>
    <p class="section__lead">{ui.contact.lead}</p>

    <div class="contact__panel">
      <p class="contact__location">{site.location}</p>
      <ul class="contact__links">
        <li>
          <a href={site.links.github} target="_blank" rel="noopener noreferrer"
            >GitHub</a
          >
        </li>
        <li>
          <a
            href={site.links.mastodon}
            target="_blank"
            rel="me noopener noreferrer">Mastodon</a
          >
        </li>
        <li>
          <a
            href={site.links.toolkit}
            target="_blank"
            rel="noopener noreferrer">{ui.contact.toolkit}</a
          >
        </li>
        <li>
          <a
            href={site.links.weltform}
            target="_blank"
            rel="noopener noreferrer">Welt Form</a
          >
        </li>
        <li>
          <a
            href={site.links.relatronica}
            target="_blank"
            rel="noopener noreferrer">Relatronica</a
          >
        </li>
        <li>
          <a
            href={site.links.soundcloud}
            target="_blank"
            rel="noopener noreferrer">SoundCloud</a
          >
        </li>
        <li>
          <a
            href={site.links.substack}
            target="_blank"
            rel="noopener noreferrer">Substack</a
          >
        </li>
      </ul>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="page-shell site-footer__inner">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <p>
      <a href="https://github.com/giuseppeaceto/Personal-Website"
        >{ui.contact.source}</a
      >
    </p>
  </div>
</footer>

<style>
  .contact__panel {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--line);
  }

  .contact__location {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .contact__links a {
    text-decoration: none;
  }

  .contact__links a:hover {
    text-decoration: underline;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: var(--space-md);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
  }
</style>
