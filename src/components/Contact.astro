---
import { getSite, getUi, resolveLocale } from "../i18n";

interface Props {
  showHeader?: boolean;
  showLead?: boolean;
}

const locale = resolveLocale(Astro.currentLocale);
const site = getSite(locale);
const ui = getUi(locale);
const { showHeader = true, showLead = true } = Astro.props;
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="page-shell">
    {
      showHeader ? (
        <>
          <p class="section__label">{ui.contact.label}</p>
          <h2 class="section__title" id="contact-title">{ui.contact.title}</h2>
          {showLead ? <p class="section__lead">{ui.contact.lead}</p> : null}
        </>
      ) : (
        <>
          <h2 class="sr-only" id="contact-title">
            {ui.contact.title}
          </h2>
          {showLead ? <p class="section__lead">{ui.contact.lead}</p> : null}
        </>
      )
    }

    <div class="contact__panel">
      <p class="contact__location">{site.location}</p>
      <ul class="contact__links">
        <li>
          <a href={site.links.github} target="_blank" rel="noopener noreferrer"
            >GitHub</a
          >
        </li>
        <li>
          <a
            href={site.links.mastodon}
            target="_blank"
            rel="me noopener noreferrer">Mastodon</a
          >
        </li>
        <li>
          <a
            href={site.links.toolkit}
            target="_blank"
            rel="noopener noreferrer">{ui.contact.toolkit}</a
          >
        </li>
        <li>
          <a
            href={site.links.weltform}
            target="_blank"
            rel="noopener noreferrer">Welt Form</a
          >
        </li>
        <li>
          <a
            href={site.links.relatronica}
            target="_blank"
            rel="noopener noreferrer">Relatronica</a
          >
        </li>
        <li>
          <a
            href={site.links.substack}
            target="_blank"
            rel="noopener noreferrer">Substack</a
          >
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .contact__panel {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--line);
  }

  .contact__location {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .contact__links a {
    text-decoration: none;
  }

  .contact__links a:hover {
    text-decoration: underline;
  }
</style>
