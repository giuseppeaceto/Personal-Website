      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line x1="12" y1="48" x2="108" y2="48" stroke-opacity="0.25" />
      <path
        d="M16 48 C32 48, 36 18, 52 18 C68 18, 72 48, 88 48"
        stroke="var(--accent)"
