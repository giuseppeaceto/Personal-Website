---
import { sound } from "../data/site";
---

<section class="section sound" id="sound" aria-labelledby="sound-title">
  <div class="page-shell">
    <p class="section__label">Sound &amp; oddities</p>
    <h2 class="section__title" id="sound-title">Listening as research</h2>
    <p class="section__lead">
      Instruments, performance, and field recording — the part of the practice that
      does not fit on a conference badge.
    </p>

    <ul class="sound-list">
      {
        sound.map((item) => (
          <li class="sound-item">
            <div class="sound-item__meta">
              <span class="sound-item__year">{item.year}</span>
              <span class="sound-item__role">{item.role}</span>
            </div>
            <div>
              {item.href ? (
                <h3 class="sound-item__title">
                  <a href={item.href} target="_blank" rel="noopener noreferrer">
                    {item.title}
                  </a>
                </h3>
              ) : (
                <h3 class="sound-item__title">{item.title}</h3>
              )}
              <p class="sound-item__summary">{item.summary}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sound-list {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .sound-item {
    display: grid;
    grid-template-columns: minmax(7rem, 11rem) 1fr;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-top: 1px solid var(--line);
  }

  .sound-item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .sound-item__meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }

  .sound-item__year {
    color: var(--accent);
  }

  .sound-item__title {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .sound-item__title a {
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0 1px;
    transition: background-size 280ms var(--ease), color 200ms var(--ease);
  }

  .sound-item__title a:hover {
    color: var(--accent);
    background-size: 100% 1px;
  }

  .sound-item__summary {
    margin: 0;
    max-width: 42rem;
    color: var(--ink-muted);
  }

  @media (max-width: 700px) {
    .sound-item {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .sound-item__meta {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
    }
  }
</style>
