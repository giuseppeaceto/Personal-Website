---
import RichParagraph from "./RichParagraph.astro";
import { getSite, getUi, pagePath, resolveLocale } from "../i18n";

interface Props {
  variant?: "full" | "brief";
}

const locale = resolveLocale(Astro.currentLocale);
const site = getSite(locale);
const { about } = site;
const ui = getUi(locale);
const { variant = "full" } = Astro.props;
const paragraphs =
  variant === "brief" ? about.paragraphs.slice(0, 1) : about.paragraphs;
const isBrief = variant === "brief";
---

<section
  class:list={["section", "intro", isBrief && "intro--brief"]}
  id="about"
  aria-labelledby="intro-name"
>
  <div class="page-shell intro__grid">
    <header class="intro__mast">
      <p class="intro__label">{ui.intro.label}</p>
      <h1 id="intro-name" class="intro__name">{site.name}</h1>
      <p class="intro__meta">{ui.hero.meta}</p>
      <p class="intro__tagline">{site.tagline}</p>
    </header>

    <div class="intro__copy">
      <RichParagraph parts={about.lead} class="intro__lead" />
      {
        paragraphs.map((paragraph) => (
          <RichParagraph parts={paragraph} />
        ))
      }
      {
        isBrief ? (
          <p class="intro__more">
            <a href={pagePath(locale, "about")}>{ui.home.readAbout}</a>
          </p>
        ) : null
      }
    </div>
  </div>
</section>

<style>
  .intro {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-lg);
  }

  .intro--brief {
    padding-top: var(--space-lg);
    padding-bottom: var(--space-md);
  }

  .intro__grid {
    display: grid;
    grid-template-columns: minmax(16rem, 0.95fr) minmax(0, 1.2fr);
    gap: clamp(1.75rem, 4vw, 3.25rem);
    align-items: start;
  }

  .intro__mast {
    position: sticky;
    top: 5.25rem;
    padding-right: 0.5rem;
    animation: rise-in 0.85s var(--ease) both;
  }

  .intro__label {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .intro__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.15rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .intro__meta {
    margin: 0.95rem 0 0;
    padding-top: 0.95rem;
    border-top: 1px solid color-mix(in srgb, var(--line) 90%, transparent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .intro__tagline {
    margin: 1rem 0 0;
    max-width: 18rem;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.6vw, 1.22rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .intro__copy {
    display: grid;
    gap: 1.05rem;
    max-width: 38rem;
    padding-top: 0.15rem;
    animation: rise-in 0.85s var(--ease) 0.08s both;
  }

  .intro__copy :global(.rich-paragraph) {
    margin: 0;
    color: var(--ink-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .intro__copy :global(.intro__lead.rich-paragraph) {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.12rem, 1.8vw, 1.32rem);
    line-height: 1.45;
    letter-spacing: -0.015em;
  }

  .intro__more {
    margin: 0.4rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .intro__more a {
    text-decoration: none;
    color: var(--accent);
  }

  .intro__more a:hover {
    text-decoration: underline;
  }

  @media (max-width: 800px) {
    .intro__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .intro__mast {
      position: static;
      padding-right: 0;
      padding-bottom: var(--space-sm);
      border-bottom: 1px solid color-mix(in srgb, var(--line) 85%, transparent);
    }

    .intro__tagline {
      max-width: 28rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro__mast,
    .intro__copy {
      animation: none;
    }
  }
</style>
