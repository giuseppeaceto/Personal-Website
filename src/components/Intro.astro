---
import RichParagraph from "./RichParagraph.astro";
import { getSite, getUi, pagePath, resolveLocale } from "../i18n";

interface Props {
  /** full = Chi sono page; mast = home identity + practice orientation */
  variant?: "full" | "mast";
}

const locale = resolveLocale(Astro.currentLocale);
const site = getSite(locale);
const { about } = site;
const ui = getUi(locale);
const { variant = "full" } = Astro.props;
const isMast = variant === "mast";
const approachHref = pagePath(locale, "approach");
---

<section
  class:list={["section", "intro", isMast && "intro--mast"]}
  id={isMast ? "intro" : "about"}
  aria-labelledby="intro-name"
>
  <div class:list={["page-shell", "intro__grid", isMast && "intro__grid--mast"]}>
    <header class="intro__mast">
      <p class="intro__label">{ui.intro.label}</p>
      <h1 id="intro-name" class="intro__name">{site.name}</h1>
      <p class="intro__meta">{ui.hero.meta}</p>
      <p class="intro__tagline">{site.tagline}</p>
    </header>

    {
      isMast ? (
        <div class="intro__orient">
          <p class="intro__orient-lead">{ui.home.mastLead}</p>
          <ul class="intro__positions">
            {ui.approach.theses.map((thesis) => (
              <li>
                <a class="intro__position" href={approachHref}>
                  <span class="intro__position-tag">{thesis.tag}</span>
                  <span class="intro__position-title">{thesis.title}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="intro__orient-more">
            <a href={approachHref}>{ui.home.mastApproach}</a>
          </p>
        </div>
      ) : (
        <div class="intro__copy">
          <RichParagraph parts={about.lead} class="intro__lead" />
          {about.paragraphs.map((paragraph) => (
            <RichParagraph parts={paragraph} />
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .intro {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-lg);
  }

  .intro--mast {
    padding-top: var(--space-lg);
    padding-bottom: var(--space-md);
  }

  .intro__grid {
    display: grid;
    grid-template-columns: minmax(16rem, 0.95fr) minmax(0, 1.2fr);
    gap: clamp(1.75rem, 4vw, 3.25rem);
    align-items: start;
  }

  .intro__grid--mast {
    grid-template-columns: minmax(15rem, 0.9fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .intro__orient {
    display: grid;
    gap: 1.25rem;
    max-width: 34rem;
    margin: 0;
    padding: 0;
    animation: rise-in 0.85s var(--ease) 0.06s both;
  }

  .intro__orient-lead {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.9vw, 1.35rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .intro__positions {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid color-mix(in srgb, var(--line) 85%, transparent);
  }

  .intro__position {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0.75rem 1rem;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 85%, transparent);
    text-decoration: none;
    color: inherit;
    transition: color 180ms var(--ease);
  }

  .intro__position:hover {
    color: var(--accent);
  }

  .intro__position:hover .intro__position-tag {
    color: var(--accent);
  }

  .intro__position-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    transition: color 180ms var(--ease);
  }

  .intro__position-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .intro__orient-more {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .intro__orient-more a {
    text-decoration: none;
    color: var(--accent);
  }

  .intro__orient-more a:hover {
    text-decoration: underline;
  }

  .intro__mast {
    position: sticky;
    top: 5.25rem;
    padding-right: 0.5rem;
    animation: rise-in 0.85s var(--ease) both;
  }

  .intro--mast .intro__mast {
    position: static;
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: 0;
    max-width: 18rem;
  }

  .intro__label {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .intro--mast .intro__label {
    margin: 0;
  }

  .intro__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.15rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  /* Home: name quieter, sized to share a top line with the right lead */
  .intro--mast .intro__name {
    font-size: clamp(1.15rem, 1.9vw, 1.35rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.35;
    color: var(--ink-muted);
  }

  .intro__meta {
    margin: 0.95rem 0 0;
    padding-top: 0.95rem;
    border-top: 1px solid color-mix(in srgb, var(--line) 90%, transparent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .intro--mast .intro__meta {
    margin: 0;
    padding: 0.15rem 0 0;
    border: 0;
    max-width: 16rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 1.8rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    text-transform: none;
    line-height: 1.18;
    color: var(--ink);
  }

  .intro__tagline {
    margin: 1rem 0 0;
    max-width: 18rem;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.6vw, 1.22rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .intro--mast .intro__tagline {
    margin: 0.15rem 0 0;
    max-width: 16rem;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--ink-muted);
  }

  .intro__copy {
    display: grid;
    gap: 1.05rem;
    max-width: 38rem;
    padding-top: 0.15rem;
    animation: rise-in 0.85s var(--ease) 0.08s both;
  }

  .intro__copy :global(.rich-paragraph) {
    margin: 0;
    color: var(--ink-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .intro__copy :global(.intro__lead.rich-paragraph) {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.12rem, 1.8vw, 1.32rem);
    line-height: 1.45;
    letter-spacing: -0.015em;
  }

  @media (max-width: 800px) {
    .intro__grid,
    .intro__grid--mast {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .intro__mast {
      position: static;
      padding-right: 0;
      padding-bottom: var(--space-sm);
      border-bottom: 1px solid color-mix(in srgb, var(--line) 85%, transparent);
    }

    .intro--mast .intro__mast {
      max-width: none;
      padding-bottom: var(--space-sm);
      border-bottom: 1px solid color-mix(in srgb, var(--line) 85%, transparent);
    }

    .intro--mast .intro__meta,
    .intro--mast .intro__tagline {
      max-width: 28rem;
    }

    .intro__tagline {
      max-width: 28rem;
    }

    .intro__position {
      grid-template-columns: 6.75rem minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro__mast,
    .intro__orient,
    .intro__copy {
      animation: none;
    }
  }
</style>

