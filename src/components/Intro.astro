---
import RichParagraph from "./RichParagraph.astro";
import { getSite, getUi, pagePath, resolveLocale } from "../i18n";

interface Props {
  variant?: "full" | "brief";
}

const locale = resolveLocale(Astro.currentLocale);
const site = getSite(locale);
const { about } = site;
const ui = getUi(locale);
const { variant = "full" } = Astro.props;
const paragraphs =
  variant === "brief" ? about.paragraphs.slice(0, 2) : about.paragraphs;
---

<section class="section intro" id="about" aria-labelledby="intro-name">
  <div class="page-shell intro__grid">
    <div class="intro__identity">
      <p class="section__label">{ui.intro.label}</p>
      <h1 id="intro-name" class="intro__name">{site.name}</h1>
      <p class="intro__roles">{ui.hero.meta}</p>
      <p class="intro__tagline">{site.tagline}</p>
    </div>
    <div class="intro__copy">
      <RichParagraph parts={about.lead} class="intro__lead" />
      {paragraphs.map((paragraph) => (
        <RichParagraph parts={paragraph} />
      ))}
      {
        variant === "brief" ? (
          <p class="intro__more">
            <a href={pagePath(locale, "about")}>{ui.home.readAbout}</a>
          </p>
        ) : null
      }
    </div>
  </div>
</section>

<style>
  .intro {
    padding-top: var(--space-lg);
  }

  .intro__grid {
    display: grid;
    grid-template-columns: minmax(14rem, 0.9fr) 1.1fr;
    gap: var(--space-lg);
    align-items: start;
  }

  .intro__identity {
    animation: rise-in 0.85s var(--ease) both;
  }

  .intro__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .intro__roles {
    margin: 0.85rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .intro__tagline {
    margin: 1.15rem 0 0;
    max-width: 22rem;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .intro__copy {
    display: grid;
    gap: 1rem;
    max-width: 40rem;
    animation: rise-in 0.85s var(--ease) 0.08s both;
  }

  .intro__copy :global(.rich-paragraph) {
    margin: 0;
    color: var(--ink-muted);
    font-size: 1.08rem;
  }

  .intro__copy :global(.intro__lead.rich-paragraph) {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.4rem);
    line-height: 1.45;
  }

  .intro__more {
    margin: 0.25rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .intro__more a {
    text-decoration: none;
  }

  .intro__more a:hover {
    text-decoration: underline;
  }

  @media (max-width: 800px) {
    .intro__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro__identity,
    .intro__copy {
      animation: none;
    }
  }
</style>
