---
import { work } from "../data/site";
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="page-shell">
    <p class="section__label">Selected work</p>
    <h2 class="section__title" id="work-title">Projects & interventions</h2>
    <p class="section__lead">
      Speculative design, ethical tooling, workshops, and sound as research —
      practices that treat AI as a social system, not just a technical one.
    </p>

    <ul class="work-list">
      {
        work.map((item) => (
          <li class="work-item">
            <div class="work-item__meta">
              <span class="work-item__year">{item.year}</span>
              <span class="work-item__role">{item.role}</span>
            </div>
            <div class="work-item__body">
              {item.href ? (
                <h3 class="work-item__title">
                  <a href={item.href} target="_blank" rel="noopener noreferrer">
                    {item.title}
                  </a>
                </h3>
              ) : (
                <h3 class="work-item__title">{item.title}</h3>
              )}
              <p class="work-item__summary">{item.summary}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .work-list {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
  }

  .work-item {
    display: grid;
    grid-template-columns: minmax(7rem, 11rem) 1fr;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-top: 1px solid var(--line);
  }

  .work-item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .work-item__meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }

  .work-item__year {
    color: var(--accent);
  }

  .work-item__title {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .work-item__title a {
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0 1px;
    transition: background-size 280ms var(--ease), color 200ms var(--ease);
  }

  .work-item__title a:hover {
    color: var(--accent);
    background-size: 100% 1px;
  }

  .work-item__summary {
    margin: 0;
    max-width: 42rem;
    color: var(--ink-muted);
  }

  @media (max-width: 700px) {
    .work-item {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .work-item__meta {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
    }
  }
</style>
