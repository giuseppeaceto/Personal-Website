---
import { getSite, getUi, pagePath, resolveLocale } from "../i18n";

interface Props {
  limit?: number;
  showHeader?: boolean;
  showAllLink?: boolean;
}

const locale = resolveLocale(Astro.currentLocale);
const { work } = getSite(locale);
const ui = getUi(locale);
const { limit, showHeader = true, showAllLink = false } = Astro.props;
const items = limit ? work.slice(0, limit) : work;
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="page-shell">
    {
      showHeader ? (
        <>
          <p class="section__label">{ui.work.label}</p>
          <h2 class="section__title" id="work-title">
            {ui.work.title}
          </h2>
          <p class="section__lead">{ui.work.lead}</p>
        </>
      ) : (
        <h2 class="sr-only" id="work-title">
          {ui.work.title}
        </h2>
      )
    }

    <ul class="work-index">
      {
        items.map((item) => {
          const Tag = item.href ? "a" : "div";
          const linkProps = item.href
            ? {
                href: item.href,
                target: "_blank",
                rel: "noopener noreferrer",
              }
            : {};
          return (
            <li>
              <Tag class="work-row" {...linkProps}>
                <span class="work-row__year">{item.year}</span>
                <span class="work-row__main">
                  <span class="work-row__title">{item.title}</span>
                  <span class="work-row__blurb">{item.blurb}</span>
                </span>
                <span class="work-row__role">{item.role}</span>
              </Tag>
            </li>
          );
        })
      }
    </ul>

    {
      showAllLink ? (
        <p class="work__all">
          <a href={pagePath(locale, "work")}>{ui.home.allWork}</a>
        </p>
      ) : null
    }
  </div>
</section>

<style>
  .work {
    padding-bottom: var(--space-lg);
  }

  .work:has(.section__title) .section__title {
    font-size: clamp(1.45rem, 2.5vw, 1.85rem);
  }

  .work:has(.section__title) .section__lead {
    font-size: 0.98rem;
  }

  .work:has(.section__title) .work-index {
    margin-top: var(--space-md);
  }

  .work-index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .work-index li {
    border-bottom: 1px solid var(--line);
  }

  .work-row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    gap: 0.85rem 1.1rem;
    align-items: baseline;
    padding: 0.85rem 0;
    text-decoration: none;
    color: inherit;
    transition: color 180ms var(--ease);
  }

  a.work-row:hover .work-row__title {
    color: var(--accent);
  }

  a.work-row:hover .work-row__role {
    color: var(--ink);
  }

  .work-row__year {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--accent);
  }

  .work-row__main {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .work-row__title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.02em;
    transition: color 180ms var(--ease);
  }

  .work-row__blurb {
    font-size: 0.86rem;
    line-height: 1.4;
    color: var(--ink-muted);
  }

  .work-row__role {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-align: right;
    white-space: nowrap;
    transition: color 180ms var(--ease);
  }

  .work__all {
    margin: var(--space-sm) 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .work__all a {
    text-decoration: none;
  }

  .work__all a:hover {
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .work-row {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      gap: 0.35rem 0.85rem;
      padding: 0.75rem 0;
    }

    .work-row__role {
      grid-column: 2;
      text-align: left;
      white-space: normal;
    }
  }
</style>
