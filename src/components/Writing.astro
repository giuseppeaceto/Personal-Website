---
import { site } from "../data/site";

const { writing } = site;
---

<section class="section writing" id="writing" aria-labelledby="writing-title">
  <div class="page-shell writing__grid">
    <div>
      <p class="section__label">Writing</p>
      <h2 class="section__title" id="writing-title">{writing.title}</h2>
      <p class="section__lead">{writing.summary}</p>
      <div class="writing__actions">
        <a
          class="writing__cta"
          href={writing.href}
          target="_blank"
          rel="noopener noreferrer">Read & subscribe</a
        >
      </div>
    </div>

    <ul class="writing__list">
      {
        writing.recent.map((item) => (
          <li>
            <a href={writing.href} target="_blank" rel="noopener noreferrer">
              <span class="writing__item-title">{item.title}</span>
              <span class="writing__item-note">{item.note}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .writing__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-lg);
    align-items: end;
  }

  .writing__actions {
    margin-top: var(--space-md);
  }

  .writing__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.15rem;
    background: var(--ink);
    color: #f3f5f7;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .writing__cta:hover {
    background: var(--accent);
    color: #f3f5f7;
  }

  .writing__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .writing__list li {
    border-bottom: 1px solid var(--line);
  }

  .writing__list a {
    display: grid;
    gap: 0.35rem;
    padding-block: 1rem;
    text-decoration: none;
  }

  .writing__list a:hover .writing__item-title {
    color: var(--accent);
  }

  .writing__item-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    transition: color 200ms var(--ease);
  }

  .writing__item-note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
  }

  @media (max-width: 800px) {
    .writing__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
      align-items: start;
    }
  }
</style>
