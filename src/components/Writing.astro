---
import {
  essayPath,
  getEssays,
  getSite,
  getUi,
  resolveLocale,
} from "../i18n";

const locale = resolveLocale(Astro.currentLocale);
const { writing } = getSite(locale);
const ui = getUi(locale);
const essays = getEssays(locale);

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString(
    locale === "it" ? "it-IT" : "en-US",
    { year: "numeric", month: "short", day: "numeric" },
  );
}
---

<section class="writing" id="writing" aria-label={ui.pages.writingTitle}>
  <div class="page-shell writing__body">
    <div class="writing__main">
      <div class="writing__on-site">
        <p class="writing__kicker">{ui.writing.onThisSite}</p>
        <ul class="writing__index writing__index--site">
          {
            essays.map((essay) => (
              <li>
                <a class="writing__row" href={essayPath(locale, essay.slug)}>
                  <span class="writing__row-meta">
                    <time datetime={essay.date}>{formatDate(essay.date)}</time>
                  </span>
                  <span class="writing__row-title">{essay.title}</span>
                  <span class="writing__row-note">{essay.dek}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="writing__elsewhere">
        <p class="writing__kicker">{ui.writing.elsewhereLabel}</p>
        <ul class="writing__index">
          {
            writing.recent.map((item) => (
              <li>
                <a
                  class="writing__row writing__row--compact"
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="writing__row-title">{item.title}</span>
                  <span class="writing__row-note">{item.note}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <aside class="writing__side" aria-label={ui.writing.newsletterLabel}>
      <div class="writing__newsletter">
        <p class="writing__kicker">{ui.writing.newsletterLabel}</p>
        <h2 class="writing__newsletter-title">{writing.title}</h2>
        <p class="writing__newsletter-summary">{writing.summary}</p>
        <a
          class="writing__cta"
          href={writing.href}
          target="_blank"
          rel="noopener noreferrer">{ui.writing.readSubscribe}</a
        >
      </div>
    </aside>
  </div>
</section>

<style>
  .writing {
    padding-top: var(--space-lg);
    padding-bottom: var(--space-xl);
  }

  .writing__body {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr);
    gap: var(--space-lg) clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .writing__main {
    display: grid;
    gap: var(--space-lg);
    min-width: 0;
  }

  .writing__side {
    min-width: 0;
    position: sticky;
    top: 5.5rem;
  }

  .writing__kicker {
    margin: 0 0 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .writing__newsletter {
    display: grid;
    gap: 0.55rem;
    padding: 1.15rem 1.2rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--line) 90%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--paper) 65%, white);
  }

  .writing__newsletter-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .writing__newsletter-summary {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--ink-muted);
  }

  .writing__cta {
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
  }

  .writing__cta:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .writing__elsewhere,
  .writing__on-site {
    display: grid;
    gap: 0;
  }

  .writing__index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .writing__index li {
    border-bottom: 1px solid var(--line);
  }

  .writing__row {
    display: grid;
    gap: 0.3rem;
    padding: 0.95rem 0;
    text-decoration: none;
  }

  .writing__row--compact {
    padding: 0.85rem 0;
  }

  .writing__row:hover .writing__row-title {
    color: var(--accent);
  }

  .writing__row-meta {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .writing__row-title {
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
    transition: color 180ms var(--ease);
  }

  .writing__index--site .writing__row-title {
    font-size: 1.22rem;
  }

  .writing__row-note {
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--ink-muted);
  }

  @media (max-width: 820px) {
    .writing__body {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .writing__side {
      position: static;
      order: 2;
    }

    .writing__elsewhere {
      order: 3;
    }

    .writing__main {
      display: contents;
    }

    .writing__on-site {
      order: 1;
    }
  }
</style>
