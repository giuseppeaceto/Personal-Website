---
import { essayPath, getSite, getUi, resolveLocale } from "../i18n";

const locale = resolveLocale(Astro.currentLocale);
const { writing, essay } = getSite(locale);
const ui = getUi(locale);
const excerpt = essay.body.slice(0, 2);
const essayHref = essayPath(locale, essay.slug);
---

<section class="section writing" id="writing" aria-labelledby="writing-title">
  <div class="page-shell">
    <p class="section__label">{ui.writing.label}</p>
    <div class="writing__intro">
      <div>
        <h2 class="section__title" id="writing-title">{writing.title}</h2>
        <p class="section__lead">{writing.summary}</p>
      </div>
      <a
        class="writing__cta"
        href={writing.href}
        target="_blank"
        rel="noopener noreferrer">{ui.writing.readSubscribe}</a
      >
    </div>

    <article class="writing__essay">
      <p class="writing__essay-label">{ui.writing.onThisSite}</p>
      <h3 class="writing__essay-title">
        <a href={essayHref}>{essay.title}</a>
      </h3>
      <p class="writing__essay-dek">{essay.dek}</p>
      <div class="writing__excerpt">
        {excerpt.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <a class="writing__continue" href={essayHref}>{ui.writing.continueReading}</a>
    </article>

    <ul class="writing__list">
      {
        writing.recent.map((item) => (
          <li>
            <a href={writing.href} target="_blank" rel="noopener noreferrer">
              <span class="writing__item-title">{item.title}</span>
              <span class="writing__item-note">{item.note}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .writing__intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .writing__intro .section__title {
    margin-bottom: var(--space-sm);
  }

  .writing__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0;
    background: transparent;
    color: var(--ink-muted);
    text-decoration: underline;
    text-underline-offset: 0.22em;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .writing__cta:hover {
    color: var(--accent);
  }

  .writing__essay {
    padding-block: var(--space-lg);
    margin-bottom: var(--space-md);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .writing__essay-label {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .writing__essay-title {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .writing__essay-title a {
    text-decoration: none;
  }

  .writing__essay-title a:hover {
    color: var(--accent);
  }

  .writing__essay-dek {
    margin: 0 0 var(--space-md);
    max-width: 36rem;
    font-size: 1.05rem;
    color: var(--ink-muted);
  }

  .writing__excerpt {
    display: grid;
    gap: 1rem;
    max-width: 38rem;
  }

  .writing__excerpt p {
    margin: 0;
    color: var(--ink);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .writing__continue {
    display: inline-block;
    margin-top: var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .writing__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .writing__list li {
    border-bottom: 1px solid var(--line);
  }

  .writing__list a {
    display: grid;
    gap: 0.35rem;
    padding-block: 1rem;
    text-decoration: none;
  }

  .writing__list a:hover .writing__item-title {
    color: var(--accent);
  }

  .writing__item-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    transition: color 200ms var(--ease);
  }

  .writing__item-note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--ink-muted);
  }
</style>
