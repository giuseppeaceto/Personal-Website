---
import RichParagraph from "./RichParagraph.astro";
import { getSite, resolveLocale } from "../i18n";

const locale = resolveLocale(Astro.currentLocale);
const { tradition } = getSite(locale);
---

<section
  class="section tradition"
  id="tradition"
  aria-labelledby="tradition-title"
>
  <div class="page-shell tradition__grid">
    <div class="tradition__copy">
      <p class="section__label">{tradition.label}</p>
      <h2 class="tradition__title" id="tradition-title">{tradition.title}</h2>
      <RichParagraph parts={tradition.lead} class="tradition__lead" />
      {tradition.paragraphs.map((paragraph) => (
        <RichParagraph parts={paragraph} />
      ))}
    </div>
    <figure class="tradition__figure">
      <div class="tradition__art">
        <img
          class="tradition__image"
          src="/images/continuous-monument.jpg"
          alt={tradition.figure.alt}
          width="800"
          height="661"
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption>
        <p class="tradition__figure-title">{tradition.figure.title}</p>
        <p class="tradition__figure-note">{tradition.figure.note}</p>
        <p class="tradition__figure-credit">
          <a
            href={tradition.figure.sourceHref}
            target="_blank"
            rel="noopener noreferrer"
          >
            {tradition.figure.sourceLabel}
          </a>
        </p>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .tradition {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .tradition__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(15rem, 0.9fr);
    gap: var(--space-lg);
    align-items: start;
  }

  .tradition__copy {
    display: grid;
    gap: 1rem;
    max-width: 40rem;
    animation: rise-in 0.85s var(--ease) both;
  }

  .tradition__copy :global(.rich-paragraph) {
    margin: 0;
    color: var(--ink-muted);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .tradition__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.6vw, 1.9rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .tradition__copy :global(.tradition__lead.rich-paragraph) {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(1.12rem, 1.9vw, 1.28rem);
    line-height: 1.45;
  }

  .tradition__figure {
    margin: 0;
    position: sticky;
    top: 5.5rem;
    animation: rise-in 0.85s var(--ease) 0.08s both;
  }

  .tradition__art {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--line) 85%, transparent);
    border-radius: var(--radius);
    background: #d8e0e8;
    box-shadow: 0 18px 36px -28px rgba(26, 28, 31, 0.45);
  }

  .tradition__image {
    width: 100%;
    height: auto;
    display: block;
  }

  .tradition__figure-title {
    margin: 0.75rem 0 0;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink);
  }

  .tradition__figure-note,
  .tradition__figure-credit {
    margin: 0.35rem 0 0;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--ink-muted);
  }

  .tradition__figure-credit {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .tradition__figure-credit a {
    text-decoration: none;
  }

  .tradition__figure-credit a:hover {
    text-decoration: underline;
    color: var(--accent);
  }

  @media (max-width: 860px) {
    .tradition__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .tradition__figure {
      position: static;
      max-width: 26rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tradition__copy,
    .tradition__figure {
      animation: none;
    }
  }
</style>
