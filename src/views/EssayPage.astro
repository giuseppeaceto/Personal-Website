---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  ESSAYS_MIRROR_UPDATED,
  getEssay,
  getSite,
  getUi,
  homePath,
  pagePath,
  resolveLocale,
} from "../i18n";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const site = getSite(locale);
const ui = getUi(locale);
const essay = getEssay(locale, slug);

if (!essay) {
  return Astro.redirect(pagePath(locale, "writing"));
}

const { writing } = site;
const title = `${essay.title} — ${site.name}`;
const writingHref = pagePath(locale, "writing");
const dateModified =
  essay.updated ??
  (essay.substackHref ? ESSAYS_MIRROR_UPDATED : essay.date);
const dateLabel = new Date(essay.date).toLocaleDateString(
  locale === "it" ? "it-IT" : "en-US",
  { year: "numeric", month: "short", day: "numeric" },
);
---

<BaseLayout
  title={title}
  description={essay.dek}
  ogType="article"
  ogImageAlt={essay.title}
  article={{
    headline: essay.title,
    datePublished: essay.date,
    dateModified,
  }}
  breadcrumbs={[
    { name: site.name, href: homePath(locale) },
    { name: ui.pages.writingTitle, href: writingHref },
    { name: essay.title, href: Astro.url.pathname },
  ]}
>
  <header class="essay-top">
    <div class="page-shell essay-top__inner">
      <a class="essay-top__back" href={writingHref}>{ui.essay.back}</a>
      <a class="essay-top__home" href={homePath(locale)}>{site.name}</a>
    </div>
  </header>

  <main id="main" class="essay">
    <article class="page-shell essay__article">
      <p class="essay__meta">
        <time datetime={essay.date}>{dateLabel}</time>
        · {ui.essay.onThisSite}
      </p>
      <h1 class="essay__title">{essay.title}</h1>
      <p class="essay__dek">{essay.dek}</p>
      <div class="essay__body">
        {
          essay.body.map((block) => {
            if (block.type === "h2") {
              return <h2 class="essay__subhead">{block.text}</h2>;
            }
            if (block.type === "quote") {
              return (
                <blockquote class="essay__quote">
                  <p>{block.text}</p>
                </blockquote>
              );
            }
            return <p>{block.text}</p>;
          })
        }
      </div>
      <p class="essay__more">
        {
          essay.substackHref ? (
            <>
              {ui.essay.alsoOnPrefix}{" "}
              <a
                href={essay.substackHref}
                target="_blank"
                rel="noopener noreferrer"
              >
                {writing.title}
              </a>
              .
            </>
          ) : (
            <>
              {ui.essay.morePrefix}{" "}
              <a
                href={writing.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {writing.title}
              </a>{" "}
              {ui.essay.moreSuffix}
            </>
          )
        }
      </p>
    </article>
  </main>

  <footer class="essay-footer">
    <div class="page-shell essay-footer__inner">
      <a href={pagePath(locale, "contact")}>{ui.essay.getInTouch}</a>
      <a href={homePath(locale)}>{ui.essay.backHome}</a>
    </div>
  </footer>
</BaseLayout>

<style>
  .essay-top {
    border-bottom: 1px solid var(--line);
    background: transparent;
  }

  .essay-top__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .essay-top a {
    text-decoration: none;
  }

  .essay-top a:hover {
    text-decoration: underline;
  }

  .essay {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .essay__article {
    max-width: 40rem;
  }

  .essay__meta {
    margin: 0 0 var(--space-md);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .essay__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .essay__dek {
    margin: var(--space-md) 0 0;
    font-size: 1.15rem;
    line-height: 1.45;
    color: var(--ink-muted);
  }

  .essay__body {
    display: grid;
    gap: 1.25rem;
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--line);
  }

  .essay__body p {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .essay__subhead {
    margin: 0.4rem 0 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .essay__quote {
    margin: 0;
    padding: 0.15rem 0 0.15rem 0.95rem;
    border-left: 2px solid color-mix(in srgb, var(--accent) 55%, var(--line));
  }

  .essay__quote p {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--ink);
  }

  .essay__more {
    margin: var(--space-lg) 0 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .essay-footer {
    border-top: 1px solid var(--line);
    padding-block: var(--space-md);
  }

  .essay-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .essay-footer a {
    text-decoration: none;
  }

  .essay-footer a:hover {
    text-decoration: underline;
  }
</style>
